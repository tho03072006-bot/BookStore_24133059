# Chép vào config/email.local.properties (đã được Git bỏ qua).
# Đặt BOOKSTORE_EMAIL_CONFIG tới đường dẫn tuyệt đối của file trước khi chạy Tomcat.
# Hoặc dùng BOOKSTORE_MAIL_USER, BOOKSTORE_MAIL_PASSWORD, BOOKSTORE_MAIL_FROM.
# Gmail cần App Password. Không commit mật khẩu vào repository.
# Để trống SMTP hoặc đặt BOOKSTORE_MAIL_MODE=console: OTP in ra Console để demo.
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.from=
mail.username=
mail.password=
